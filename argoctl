#!/bin/zsh
# argoctl — control the Argo planner (launchd LaunchAgent). Sibling of kaictl.
#
#   argoctl start      install the plist + load it (starts the continuous planner loop)
#   argoctl stop       unload it + remove the installed plist (no auto-restart on login)
#   argoctl restart    stop then start (picks up the latest plist from the repo)
#   argoctl status     loaded? running? + last log lines
#   argoctl logs       tail -f the live debug log
#
# Argo (planner.py) keeps the board stocked with kai:ready cards from the PRD/milestones.
# It NEVER writes code and NEVER merges — it only creates cards. kaictl runs the build
# supervisor; argoctl runs the planner. Runs as the current user so it inherits the login
# PATH/auth. Same mechanism as kaictl, pointed at the com.kai.planner label + logs.
set -euo pipefail

HARNESS_DIR="${KAI_HARNESS_DIR:-$HOME/kai-harness}"
LABEL="com.kai.planner"
PLIST_SRC="$HARNESS_DIR/launchd/$LABEL.plist"
PLIST_DST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_ERR="$HARNESS_DIR/logs/planner.err.log"
DOMAIN="gui/$(id -u)"

status() {
  echo "== launchctl (PID / last-exit / label) =="
  launchctl list | grep -i planner || echo "  not loaded"
  echo "== process =="
  pgrep -fl planner.py || echo "  no process"
  echo "== last log lines ($LOG_ERR) =="
  tail -n 6 "$LOG_ERR" 2>/dev/null || echo "  (no log yet)"
}

start() {
  [ -f "$PLIST_SRC" ] || { echo "missing $PLIST_SRC — is the repo cloned?"; exit 1; }
  mkdir -p "$HARNESS_DIR/logs"
  cp "$PLIST_SRC" "$PLIST_DST"                       # always deploy the latest repo template
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true   # clear any stale load
  launchctl bootstrap "$DOMAIN" "$PLIST_DST"
  echo "started $LABEL"
  status
}

stop() {
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null && echo "stopped $LABEL" || echo "$LABEL was not loaded"
  rm -f "$PLIST_DST" && echo "removed $PLIST_DST (no auto-restart on login)"
}

restart() { stop || true; start; }

case "${1:-status}" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  status)  status ;;
  logs)    exec tail -f "$LOG_ERR" ;;
  *)       echo "usage: argoctl {start|stop|restart|status|logs}"; exit 2 ;;
esac
