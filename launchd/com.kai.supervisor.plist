<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kai supervisor — LaunchAgent (runs as your user, in the login session).

  Install / start:
    cp launchd/com.kai.supervisor.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kai.supervisor.plist
  Stop / uninstall:
    launchctl bootout gui/$(id -u)/com.kai.supervisor
  Logs (on disk):
    ~/projects/kai-harness/logs/supervisor.err.log   (the [kai] log lines + tracebacks)
    ~/projects/kai-harness/logs/supervisor.out.log

  Runs the CONTINUOUS supervisor loop via `zsh -lc` so it inherits the login PATH
  (claude, node, pnpm, gh, git). KeepAlive restarts it if it dies.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kai.supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/YOU/kai-harness &amp;&amp; exec python3 supervisor.py --project projects/my-app.project.json --poll-interval 300</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOU/kai-harness</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/YOU/kai-harness/logs/supervisor.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOU/kai-harness/logs/supervisor.err.log</string>
</dict>
</plist>
