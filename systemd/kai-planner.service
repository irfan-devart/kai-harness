# Argo planner as a systemd user service (Linux).
# Install: cp systemd/kai-planner.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now kai-planner
# Edit the path and project file below to match your setup.
[Unit]
Description=Argo planner (stocks the board from the PRD)
After=network-online.target

[Service]
ExecStart=/usr/bin/zsh -lc 'cd %h/kai-harness && exec python3 planner.py --project projects/my-app.project.json --poll-interval 300'
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
